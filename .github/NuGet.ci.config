<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- This file is copied to the repository root before any SDK resolution. -->
    <add key="cohesion-local" value="../cohesion/_out/packages" />
    <add key="viu-local" value="../viu/_out/packages" />
    <add key="github" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="cohesion-local"><package pattern="Assimalign.Cohesion.*" /></packageSource>
    <packageSource key="viu-local"><package pattern="Assimalign.Viu.*" /></packageSource>
    <packageSource key="github"><package pattern="Assimalign.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
  <config><add key="globalPackagesFolder" value=".nuget/packages" /></config>
</configuration>
