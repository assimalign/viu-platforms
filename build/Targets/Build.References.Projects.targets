<Project>
    <!--
        Project Reference By Name Only.

        Lets a library/resource/analyzer csproj reference another by its
        assembly name instead of by relative csproj path. Resolution walks
        libraries/ + resources/ (for code refs) and analyzers/ (for analyzer
        refs) once, matches each item's Include to the csproj whose filename
        matches, and emits a regular <ProjectReference Include="<resolved-path>" />
        with the appropriate per-flavor metadata.

        Three flavours:

          ViuPlatformProjectReference        - PUBLIC code reference. Resulting
                                            <ProjectReference> has default
                                            semantics: compiled against,
                                            CopyLocal'd into bin/, AND appears
                                            as a <dependency> in this library's
                                            .nupkg .nuspec (flows to consumers).

          ViuPlatformPrivateProjectReference - PRIVATE code reference. Same compile
                                            + CopyLocal behaviour, but the
                                            resulting <ProjectReference> carries
                                            PrivateAssets="all", which suppresses
                                            the <dependency> entry in the .nuspec.
                                            Consumers of this library's .nupkg
                                            never learn about the target.

                                            Use for "this library needs X as an
                                            internal implementation detail but
                                            should not expose X to its consumers".
                                            Pair with a matching
                                            <ViuPlatformFrameworkPrivateAssembly>
                                            entry in
                                            frameworks/Assimalign.ViuPlatform.App.props
                                            so the containing framework's
                                            Runtime pack still ships X.dll at
                                            run time.
    -->
    <ItemGroup>
        <!-- Index code projects ONCE. -->
        <_ViuPlatformProject Include="$(ViuPlatformsRepositoryDirectory)platforms\**\*.csproj" />
        <_ViuPlatformProject Update="@(_ViuPlatformProject)" ProjectId="%(_ViuPlatformProject.Filename)" ProjectPath="%(_ViuPlatformProject.Identity)" />

        <!-- Public refs -->
        <ViuPlatformProjectReference Update="@(_ViuPlatformProject->'%(ProjectId)')" ProjectPath="%(_ViuPlatformProject.ProjectPath)" />
        <ProjectReference Include="@(ViuPlatformProjectReference->'%(ProjectPath)')" />
        <ViuPlatformProjectReference Remove="@(ViuPlatformProjectReference->HasMetadata('ProjectPath'))" />

        <!-- Private refs: PrivateAssets='all' suppresses .nuspec <dependency> flow. -->
        <ViuPlatformPrivateProjectReference Update="@(_ViuPlatformProject->'%(ProjectId)')" ProjectPath="%(_ViuPlatformProject.ProjectPath)" />
        <ProjectReference Include="@(ViuPlatformPrivateProjectReference->'%(ProjectPath)')" PrivateAssets="all" />
        <ViuPlatformPrivateProjectReference Remove="@(ViuPlatformPrivateProjectReference->HasMetadata('ProjectPath'))" />

        <_ViuPlatformProject Remove="@(_ViuPlatformProject)" />
    </ItemGroup>
</Project>
