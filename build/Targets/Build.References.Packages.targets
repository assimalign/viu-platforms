<Project>
  <PropertyGroup>
    <CohesionVersion>10.0.0-beta.1</CohesionVersion>
    <ViuVersion>10.0.0-beta.11</ViuVersion>
  </PropertyGroup>

  <ItemGroup>
    <_ViuPlatformPackage Update="Assimalign.Cohesion.Configuration" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.DependencyInjection" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.Hosting" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.FileSystem" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.FileSystem.Globbing" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.FileSystem.Physical" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.Http" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.Web" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Cohesion.Web.Server" Version="$(CohesionVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Viu.Browser" Version="$(ViuVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Viu.Components" Version="$(ViuVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Viu.Core" Version="$(ViuVersion)" />
    <_ViuPlatformPackage Update="Assimalign.Viu.ServerRenderer" Version="$(ViuVersion)" />
    <_ViuPlatformPackage Update="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <_ViuPlatformPackage Update="Shouldly" Version="4.3.0" />
    <_ViuPlatformPackage Update="xunit" Version="2.9.3" />
    <_ViuPlatformPackage Update="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>


      <ItemGroup>
        <ViuPlatformPackageReference Update="@(_ViuPlatformPackage)" Version="%(_ViuPlatformPackage.Version)" />
        <PackageReference Include="@(ViuPlatformPackageReference)" />
        <ViuPlatformPackageReference Remove="@(ViuPlatformPackageReference)" />
    </ItemGroup>
</Project>
