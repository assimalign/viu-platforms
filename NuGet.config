<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Project-SDK resolution reads this file before restore properties exist, so the msbuild-sdks
       pins in global.json resolve through these same sources. CI uses this file unchanged. -->
  <packageSources>
    <clear />
    <add key="viu-platforms-local" value="_out/packages" />
    <!-- Viu publishes no packages to a feed yet. This is its scripts/Install-Local.ps1 output: the
         sibling checkout locally, .github/scripts/Pack-ViuSibling.ps1 in CI. -->
    <add key="viu-local" value="../viu/_out/packages" />
    <!-- Cohesion CI builds (10.0.0-preview.0.ci.N) and releases. GitHub Packages requires a token
         with read:packages even for public packages. Never commit it; supply it from the environment:
         NuGetPackageSourceCredentials_assimalign=Username=<user>;Password=<token> -->
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="viu-platforms-local">
      <package pattern="Assimalign.Cohesion.Viu.*" />
    </packageSource>
    <packageSource key="viu-local">
      <package pattern="Assimalign.Viu.*" />
    </packageSource>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
