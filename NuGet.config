<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
      Repo-local NuGet configuration.

      - viu-platforms-local: packages produced by this repository. This is the
        external-consumer boundary used by packed-template validation.

      - cohesion-local: the sibling Cohesion feed. It supplies the beta.1 SDK,
        framework packs, and ordinary Cohesion libraries used by this platform.

      - viu-local: the sibling Viu feed. It supplies the beta.11 SDK, framework
        packs, and runtime libraries composed by the hosting packages.

      - assimalign: the authenticated-package fallback for Assimalign packages
        that are published but are not present in a sibling repository feed.

      - nuget.org: standard public feed for test and build dependencies.

      clear ensures user and machine package sources do not silently change the
      repository build.
  -->
  <packageSources>
    <clear />
    <add key="viu-platforms-local" value="_out\packages" />
    <add key="cohesion-local" value="..\cohesion\_out\packages" />
    <add key="viu-local" value="..\viu\_out\packages" />
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Exact mappings keep Cohesion beta.1 packages absent from the
         sibling feed available from the published source. The platform pattern
         allows locally packed beta.3 packages alongside the broader Cohesion family. -->
    <packageSource key="viu-platforms-local">
      <package pattern="Assimalign.Cohesion.Viu.*" />
    </packageSource>
    <packageSource key="cohesion-local">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="viu-local">
      <package pattern="Assimalign.Viu.*" />
    </packageSource>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.Core" />
      <package pattern="Assimalign.Cohesion.Content" />
      <package pattern="Assimalign.Cohesion.Content.Text" />
      <package pattern="Assimalign.Cohesion.Content.Markdown" />
      <package pattern="Assimalign.Cohesion.DependencyInjection" />
      <package pattern="Assimalign.Cohesion.Hosting" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <!-- Keep same-version local preview repacks isolated from the machine-wide
         NuGet cache. The directory is ignored by this repository. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
