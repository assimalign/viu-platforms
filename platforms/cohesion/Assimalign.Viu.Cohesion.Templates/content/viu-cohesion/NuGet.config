<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 2 uses local package feeds. The viu-cohesion template parameters replace these paths.
  Keep nuget.org for transitive Microsoft and third-party packages.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="viu-platforms-local" value="__VIU_PLATFORMS_LOCAL_FEED__" />
    <add key="cohesion-local" value="__COHESION_LOCAL_FEED__" />
    <add key="viu-local" value="__VIU_LOCAL_FEED__" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
