<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Cohesion hosting and dependency injection for Viu applications.</Description>
    <PackageTags>Viu;Cohesion;Hosting;DependencyInjection</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ViuPlatformPackageReference Include="Assimalign.Cohesion.Configuration" />
    <ViuPlatformPackageReference Include="Assimalign.Cohesion.DependencyInjection" />
    <ViuPlatformPackageReference Include="Assimalign.Cohesion.Hosting" />
    <ViuPlatformPackageReference Include="Assimalign.Viu.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\OVERVIEW.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
