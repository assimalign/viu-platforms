<Project Sdk="Assimalign.Cohesion.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFrameworkForApplications)</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Package-integrated Cohesion development server for Viu browser applications.</Description>
    <PackageTags>Viu;Cohesion;WebAssembly;WASM;DevelopmentServer</PackageTags>
    <RuntimeIdentifiers>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifiers>
    <ToolsPublishDirectory>$(BaseIntermediateOutputPath)tools-publish\$(Configuration)\$(TargetFramework)\</ToolsPublishDirectory>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddDevServerToolsToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packaged tool carries Cohesion's managed runtime-pack closure and requires only Microsoft.NETCore.App. -->
    <FrameworkReference Update="Assimalign.Cohesion.App;Assimalign.Cohesion.App.Web"
                        PrivateAssets="all" />
    <KnownFrameworkReference Update="Assimalign.Cohesion.App;Assimalign.Cohesion.App.Web"
                             Condition="'$(ViuCollectCohesionRuntimePacks)' == 'true'"
                             RuntimePackAlwaysCopyLocal="true" />
    <ProjectReference Include="..\..\Assimalign.Cohesion.Viu.Server\src\Assimalign.Cohesion.Viu.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\build\Assimalign.Cohesion.Viu.DevServer.targets" Pack="true" PackagePath="build/Assimalign.Cohesion.Viu.DevServer.targets" />
    <None Include="..\docs\OVERVIEW.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="PublishDevServerTools" BeforeTargets="AddDevServerToolsToPackage">
    <RemoveDir Directories="$(ToolsPublishDirectory)" />
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(ToolsPublishDirectory);SelfContained=false;UseAppHost=false;PublishSingleFile=false;RuntimeIdentifier=$(NETCoreSdkRuntimeIdentifier);ViuCollectCohesionRuntimePacks=true;NoBuild=false;NoRestore=true" />
  </Target>

  <Target Name="AddDevServerToolsToPackage" DependsOnTargets="PublishDevServerTools">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(ToolsPublishDirectory)**\*">
        <PackagePath>tools/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
