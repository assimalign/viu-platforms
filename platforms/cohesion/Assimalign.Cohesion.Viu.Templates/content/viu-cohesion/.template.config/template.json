{
  "$schema": "http://json.schemastore.org/template",
  "author": "Assimalign",
  "classifications": [
    "Viu",
    "Web",
    "WebAssembly",
    "Cohesion"
  ],
  "identity": "Assimalign.Cohesion.Viu.Templates.BrowserApplication",
  "name": "Viu Browser WebAssembly application with Cohesion",
  "shortName": "viu-cohesion",
  "sourceName": "CohesionViuApplication",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "primaryOutputs": [
    {
      "path": "CohesionViuApplication.csproj"
    }
  ],
  "symbols": {
    "assimalignRoot": {
      "defaultValue": "..",
      "dataType": "string",
      "replaces": "__ASSIMALIGN_ROOT__",
      "description": "Directory containing the Assimalign sibling local feeds.",
      "type": "parameter"
    }
  }
}
