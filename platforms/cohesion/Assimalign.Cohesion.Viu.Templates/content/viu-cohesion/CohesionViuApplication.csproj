<Project Sdk="Assimalign.Viu.Sdk.Browser">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CohesionViuApplication</RootNamespace>
    <AssemblyName>CohesionViuApplication</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Some .NET 10 SDK installations omit their optional PrunePackageData directory. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Assimalign.Cohesion.Viu.Hosting.Browser" Version="10.0.0-beta.2" />
    <PackageReference Include="Assimalign.Cohesion.Viu.DevServer" Version="10.0.0-beta.2" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS"
                                      Pattern="*.js"
                                      Expression="#[.{fingerprint}]!" />
  </ItemGroup>
</Project>
