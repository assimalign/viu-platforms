<template>
  <main>
    <h1>Viu + Cohesion</h1>
    <p>Application-model-aware Web hosting</p>
    <output aria-live="polite">{{ CountLabel }}</output>
    <button type="button" @click="Increment">Increment</button>
  </main>
</template>

@script {
    using Assimalign.Viu.Reactivity;

    private readonly Reference<int> CountReference = Reactive.Reference(0);

    /// <summary>Gets the current count for the template.</summary>
    public string CountLabel => $"{CountReference.Value} clicks";

    private void Increment() => CountReference.Value++;
}
